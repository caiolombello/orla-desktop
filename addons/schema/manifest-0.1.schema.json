{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "description",
    "author",
    "license",
    "version",
    "origin",
    "renderer",
    "source"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1-experimental"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))$"
    },
    "origin": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[^/\\s@?#\\\\]+(?:/[^\\s?#\\\\]*)?$"
    },
    "renderer": {
      "const": "peripheral-battery"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "formatVersion"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[a-z][a-z0-9-]{0,63})$"
        },
        "formatVersion": {
          "const": "0.1-experimental"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Experimental. Normative stdlib parser also checks strict UTF-8, 65536 bytes, depth <=8, duplicate keys, nonfinite numbers, printable text and an HTTPS URL without userinfo/query/fragment. SHA is integrity, not publisher authentication."
}
