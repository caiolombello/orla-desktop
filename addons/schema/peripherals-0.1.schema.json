{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "producer",
    "producerVersion",
    "generatedAtMs",
    "expiresAtMs",
    "intervalSeconds",
    "devices"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1-experimental"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[a-z][a-z0-9-]{0,63})$"
    },
    "producerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[A-Za-z0-9.+_-]{1,40})$"
    },
    "generatedAtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600
    },
    "devices": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "link",
          "present",
          "stale",
          "observedAtMs",
          "battery",
          "components"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mouse",
              "keyboard",
              "earbuds",
              "headset",
              "touchpad",
              "gamepad",
              "other"
            ]
          },
          "link": {
            "enum": [
              "receiver",
              "bluetooth",
              "usb",
              "unknown"
            ]
          },
          "present": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          },
          "observedAtMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "battery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "percent",
              "level",
              "charging",
              "estimated"
            ],
            "properties": {
              "percent": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "level": {
                "enum": [
                  "critical",
                  "low",
                  "good",
                  "full",
                  null
                ]
              },
              "charging": {
                "enum": [
                  "discharging",
                  "charging",
                  "full",
                  "unknown"
                ]
              },
              "estimated": {
                "type": "boolean"
              }
            }
          },
          "components": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "percent",
                "charging"
              ],
              "properties": {
                "label": {
                  "enum": [
                    "left",
                    "right",
                    "case"
                  ]
                },
                "percent": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "charging": {
                  "enum": [
                    "discharging",
                    "charging",
                    "full",
                    "unknown"
                  ]
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "label": {
                      "const": "left"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "label": {
                      "const": "right"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "label": {
                      "const": "case"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "minContains": 0,
                "maxContains": 1
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[^ ](?:.*[^ ])?)$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Experimental. Normative stdlib parser also checks strict UTF-8, 65536 bytes, depth <=8, duplicate keys, nonfinite numbers, integer tokens, producer == selected namespace and expiresAtMs == generatedAtMs + 3000 * intervalSeconds. Host independently checks envelope/observation clocks and leases."
}
